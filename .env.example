# Local Debug builds only. Copy this file to .env and fill in the keys.
# .env is ignored by Git and is never bundled into the app.
# Copy it to the phone's Documents/dev.env after installing (see README).

# Optional: improves the final transcript; Apple Speech shows live words.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_INTENT_MODEL=gpt-4.1-mini

# Optional: MBTA V3 API key (free at https://api-v3.mbta.com/register). Without it the
# limit is 20 requests/min, enough for one phone; with it 1000/min.
MBTA_API_KEY=

# Optional: Deepgram (https://console.deepgram.com, $200 free credit). When set it is preferred
# for the final transcript (Nova-3 with Boston station and chain names as keyterms) and for
# spoken replies (Flux TTS). OpenAI and ElevenLabs below are the fallbacks.
DEEPGRAM_API_KEY=
# Flux voice: flux-hannah-en, flux-miles-en (calm male), flux-cliff-en, flux-colin-en, ...
DEEPGRAM_VOICE=flux-hannah-en
# -2 (calm) to 2 (animated)
DEEPGRAM_EXPRESSIVITY=0

# Optional: speaks replies; the iPhone voice is the fallback without a key.
ELEVENLABS_API_KEY=
# Caleb — Trusted Guide. Add it from Voice Library, or use your own voice ID.
ELEVENLABS_VOICE_ID=AaOhDHYJ1XLZk74lXhdE
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Slightly slower delivery for clear, short navigation prompts (0.7–1.2).
ELEVENLABS_VOICE_SPEED=0.95
